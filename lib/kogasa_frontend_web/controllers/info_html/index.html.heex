<!doctype html>
<html
  lang="en"
  class={[
    @initial_state.ingame && "weapons-ingame",
    @panel_session && "weapons-panel-active"
  ]}
  data-steamid64={@panel_session && @panel_session.steamid64}
  data-weapons-session={@panel_session && @panel_session.token}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Weapons &middot; kogasa.tf</title>
    <meta
      name="description"
      content="Weapon changes and custom weapon list for Kogasatopia"
    />
    <meta property="og:site_name" content="Kogasatopia" />
    <meta property="og:title" content="Weapons Page" />
    <meta
      property="og:description"
      content="Weapon changes and custom weapon notes for Kogasatopia"
    />
    <meta property="og:url" content="https://kogasa.tf/info" />
    <meta property="og:type" content="website" />
    <script>
      const weaponsRoot = document.documentElement;
      const weaponsHashIsIngame = /(?:^|-)ingame(?:-|$)/.test(
        decodeURIComponent(window.location.hash.slice(1)).toLowerCase()
      );

      if (weaponsRoot.classList.contains("weapons-ingame") || weaponsHashIsIngame) {
        weaponsRoot.classList.add("weapons-ingame", "weapons-preloading");
        window.addEventListener("load", function () {
          weaponsRoot.classList.remove("weapons-preloading");
        });
      }
    </script>
    <link rel="preload" as="style" href={"/info/css/changes.css?v=" <> @asset_version} />
    <link
      :if={!@initial_state.ingame}
      rel="preload"
      as="script"
      href={"/info/js/info_page.js?v=" <> @asset_version}
    />
    <link
      :if={@panel_session}
      rel="preload"
      as="script"
      href={"/info/js/weapons_panel.js?v=" <> @asset_version}
    />
    <link rel="preload" as="font" type="font/ttf" href="/fonts/TF2Build.ttf" crossorigin />
    <link rel="preload" as="font" type="font/ttf" href="/fonts/TF2Secondary.ttf" crossorigin />
    <link
      :if={!@initial_state.ingame}
      rel="preload"
      as="audio"
      href="/info/sound/tf2-button-click.mp3"
    />
    <link
      :if={!@initial_state.ingame}
      rel="preload"
      as="image"
      href="/info/icons/backgrounds/tf2full.jpg"
      fetchpriority="high"
    />
    <link
      :for={src <- @preload_images}
      rel="preload"
      as="image"
      href={src}
      fetchpriority="high"
    />
    <link rel="stylesheet" href={"/info/css/changes.css?v=" <> @asset_version} />
    <noscript>
      <style>
        html.weapons-preloading .page { visibility: visible; }
      </style>
    </noscript>
  </head>
  <body>
    <.section_nav
      :if={!@initial_state.ingame}
      active={:weapons}
      class="weapons-nav"
      online_count_id={nil}
    />
    <div class="page">
      <header :if={!@initial_state.ingame} class="header">
        <div class="title-group">
          <div class="brand-line">
            <div class="brand">Kogasatopia Weapons Page</div>
            <div :if={@config_update} class="subtitle" title={@config_update.title}>
              {@config_update.label}
            </div>
          </div>
          <div class="subtitle">
            This server has buffs for bad weapons, many nerf reverts, and some new weapons entirely. This page works by reading the server's weapon config file, meaning it's always up to date!
          </div>
        </div>
      </header>

      <nav :if={!@initial_state.ingame} class="class-bar" id="class-bar">
        <button
          :for={class <- @classes}
          class={["class-btn", class.key == @active_class && "active"]}
          data-class={class.key}
          type="button"
        >
          <img class="class-icon" src={"/info/icons/" <> class.icon} />
          <span class="class-label">{class.label}</span>
        </button>
      </nav>

      <section class="content">
        <aside :if={!@initial_state.ingame} class="filters">
          <label class="filter-label">Search</label>
          <input type="text" id="search" class="search" placeholder="Find a weapon or effect..." />
          <label class="home-btn filter-toggle" for="custom-only">
            <input type="checkbox" id="custom-only" autocomplete="off" />
            <span>Custom weapons only</span>
          </label>
          <label class="home-btn filter-toggle" for="show-reskins">
            <input type="checkbox" id="show-reskins" autocomplete="off" checked />
            <span>Show reskins</span>
          </label>
        </aside>
        <main>
          <div
            id="button-container"
            class={@grouped_custom_ingame && "weapons-ingame-grouped"}
          >
            <%= if @grouped_custom_ingame do %>
              <section class="weapons-ingame-group">
                <span class="tab-button-label tab-button-label--desktop">Custom Weapons</span>
                <hr />
                <div class="weapons-ingame-grid">
                  <.weapon_tile
                    :for={item <- @initial_custom_items}
                    item={item}
                    inert={is_nil(@panel_session)}
                    interactive={!is_nil(@panel_session)}
                  />
                </div>
              </section>
              <section class="weapons-ingame-group">
                <span class="tab-button-label tab-button-label--desktop">Reskins</span>
                <hr />
                <div class="weapons-ingame-grid">
                  <.weapon_tile
                    :for={item <- @initial_reskin_items}
                    item={item}
                    inert={is_nil(@panel_session)}
                    interactive={!is_nil(@panel_session)}
                  />
                </div>
              </section>
            <% else %>
              <.weapon_tile
                :for={item <- @initial_items}
                item={item}
                inert={@initial_state.ingame}
                interactive={false}
              />
            <% end %>
          </div>
        </main>
      </section>
    </div>
    <script :if={!@initial_state.ingame} id="info-data" type="application/json">
      <%= Phoenix.HTML.raw(@payload_json) %>
    </script>
    <script
      :if={!@initial_state.ingame}
      defer
      src={"/info/js/info_page.js?v=" <> @asset_version}
    >
    </script>
    <script
      :if={@panel_session}
      defer
      src={"/info/js/weapons_panel.js?v=" <> @asset_version}
    >
    </script>
  </body>
</html>
